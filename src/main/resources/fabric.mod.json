{
	"schemaVersion": 1,
	"id": "mineagen",
	"version": "${version}",
	"name": "Mineagen",
	"description": "Summon configurable Codex-powered humanoid agents that can act autonomously in Minecraft.",
	"icon": "assets/mineagen/icon.png",
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"dev.agaminggod.mineagen.Mineagen"
		],
		"client": [
			"dev.agaminggod.mineagen.client.MineagenClient"
		]
	},
	"mixins": [
		"mineagen.mixins.json",
		"mineagen.compat.mixins.json",
		{
			"config": "mineagen.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "mineagen.client.compat.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "${minecraftDependency}",
		"java": ">=25",
		"fabric-api": "*",
		"carpet": "${carpetDependency}"
	}
}
